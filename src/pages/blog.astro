---
import BaseLayout from '../layout/BaseLayout.astro';
import BlogPostCard from '../components/Postcard.astro';

const pageTitle = "Blog | Morks News Network";

type Post = {
    frontmatter: {
        title: string;
        date: string;
        excerpt?: string;
        description?: string;
        image?: {
            url: string;
            alt: string;
        };
    };
    url: string;
};

// Get all posts and sort them by date
const allPosts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true })) as Post[];

// Sort posts by date in descending order (latest posts first)
const sortedPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout pageTitle={pageTitle}>
    <h1 class="title">All News</h1>

    <div class="posts-grid">
        {sortedPosts.map((post) => {
            const imageUrl = post.frontmatter.image?.url ?? '/default-fallback.jpg';
            const imageAlt = post.frontmatter.image?.alt ?? 'Post image';
            
            return (
                <BlogPostCard
                    url={post.url}
                    title={post.frontmatter.title}
                    date={post.frontmatter.date}
                    excerpt={post.frontmatter.excerpt || post.frontmatter.description}
                    imageUrl={imageUrl}
                    imageAlt={imageAlt}
                />
            );
        })}
    </div>
</BaseLayout>
